          { "score": 3, "condition": "USDJPY 130-150" },
          { "score": 1, "condition": "USDJPY>160 → 日元崩溃，日央行被迫干预" }
        ]
      },
      {
        "name": "growth",
        "label": "增长/通胀",
        "weight": 0.30,
        "indicators": ["japan_cpi_yoy", "nikkei_level"],
        "scoring_rules": [
          { "score": 5, "condition": "CPI 1-2% + 日经健康" },
          { "score": 3, "condition": "CPI<0% 或 CPI>3%" },
          { "score": 1, "condition": "滞胀或通缩恶化" }
        ]
      }
    ]
  },
  "L1_composite_formula": "us_composite × 0.60 + cn_composite × 0.40",
  "quadrant_analysis": {
    "_source": "sop/三层多因子投研框架.md §四情景象限 (v1.2)",
    "method": "QQQ月收益(US) × FXI月收益(CN) → 4象限",
    "quadrants": {
